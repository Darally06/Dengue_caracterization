content.com/media/Darally06/DATOS_DENGUE/refs/heads/main/Data_Atlantico.csv\", encoding=\"latin_1\")\npoblacion = pd.read_csv(\"Datos adjuntos/Poblacion_departamental.csv\", encoding=\"latin_1\")","identifier":"f104d694-code","enumerator":"1","html_id":"f104d694-code","key":"DwdM1M6Sd4"},{"type":"output","id":"jeG6qR7wcJapiHUge0NfZ","data":[{"output_type":"stream","name":"stdout","text":"Cloning into 'Dengue_caracterization'...\nremote: Enumerating objects: 1386, done.\u001b[K\nremote: Counting objects: 100% (25/25), done.\u001b[K\nremote: Compressing objects: 100% (23/23), done.\u001b[K\nremote: Total 1386 (delta 3), reused 17 (delta 2), pack-reused 1361 (from 2)\u001b[K\nReceiving objects: 100% (1386/1386), 169.55 MiB | 22.90 MiB/s, done.\nResolving deltas: 100% (614/614), done.\nUpdating files: 100% (738/738), done.\n/content/Dengue_caracterization/Datos adjuntos/Mapas_municipio\n/content/Dengue_caracterization\n"}],"identifier":"f104d694-output","html_id":"f104d694-output","key":"SKhHiqsiP0"}],"identifier":"f104d694","label":"f104d694","html_id":"f104d694","key":"xZ5hhjrvGo"},{"type":"block","kind":"notebook-content","data":{"id":"d20b4400"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Incidencia de casos por cada 1,000 habitantes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wEe6hRpuU9"}],"key":"F7TgflVikl"}],"identifier":"incidencia-de-casos-por-cada-1-000-habitantes","label":"Incidencia de casos por cada 1,000 habitantes","html_id":"incidencia-de-casos-por-cada-1-000-habitantes","implicit":true,"key":"lOWWJCowWG"}],"identifier":"d20b4400","label":"d20b4400","html_id":"d20b4400","key":"sEucVFCO10"},{"type":"block","kind":"notebook-code","data":{"id":"59b9b8e8"},"children":[{"type":"code","lang":"python","executable":true,"value":"# [Tabla] Casos por municipio\ntabla_mun = df.groupby([\"municipio\", \"año\", \"evento\"]).size().reset_index(name=\"casos\")\n\n# Ajustar nombres de columna para unir\npoblacion = poblacion.rename(columns={'MUNICIPIO':'municipio', 'TOTAL':'total_pob'})\n\n# Convertir columnas de año en una columna 'año'\npoblacion_long = poblacion.melt(\n    id_vars=['municipio', 'total_pob'],    # mantener municipio y total\n    value_vars=['2017.0','2018.0','2019.0','2020.0','2021.0','2022.0','2023.0'],\n    var_name='año',\n    value_name='poblacion'\n)\n\n# Asegurarse de que 'año' sea numérico\npoblacion_long['año'] = poblacion_long['año'].astype(float).astype(int)\n\n# Unir casos con población del mismo año\ntabla_mun = tabla_mun.merge(poblacion_long, on=['municipio','año'], how='left')\n\n# incidencia por año y municipio\ntabla_mun['incidencia'] = tabla_mun['casos'] / tabla_mun['poblacion']\n\n# Si quieres por cada 1000 habitantes\ntabla_mun['incidencia'] = (tabla_mun['casos'] / tabla_mun['poblacion']) * 1000\n\ntabla_mun = tabla_mun.sort_values(by='incidencia', ascending=False)","identifier":"59b9b8e8-code","enumerator":"2","html_id":"id-59b9b8e8-code","key":"RvLjzRkFpO"},{"type":"output","id":"LeduaSc2UVelmsBstvjJb","data":[],"identifier":"59b9b8e8-output","html_id":"id-59b9b8e8-output","key":"kCnU7pRzPZ"}],"identifier":"59b9b8e8","label":"59b9b8e8","html_id":"id-59b9b8e8","key":"bA2lLApxLN"},{"type":"block","kind":"notebook-code","data":{"id":"c38a8fcb","outputId":"f0118bf5-7f09-4e08-e88b-85efde9bf4a9","colab":{"base_uri":"https://localhost:8080/","height":417}},"children":[{"type":"code","lang":"python","executable":true,"value":"# incidencia global por municipio (todos los años)\nincidencia = tabla_mun.groupby(\"municipio\").agg(\n    casos_totales=('casos', 'sum'),\n    poblacion_total=('total_pob', 'first')   # la misma población total por municipio\n).reset_index()\n\nincidencia['incidencia'] = (incidencia['casos_totales'] / incidencia['poblacion_total']) * 10000\n\n# Ordenar de mayor a menor\nincidencia = incidencia.sort_values(by='incidencia', ascending=False)\n\nincidencia.head(10)\n","identifier":"c38a8fcb-code","enumerator":"3","html_id":"c38a8fcb-code","key":"IU7ZALPgGy"},{"type":"output","id":"kHA5mQJQFARn85_Wu_Djg","data":[{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"          municipio  casos_totales  poblacion_total  incidencia\n10        POLONUEVO            399         155707.0   25.625052\n0           BARANOA           1028         539600.0   19.051149\n12  PUERTO COLOMBIA            780         443890.0   17.571921\n3            GALAPA            876         519297.0   16.868959\n6           MALAMBO           1697        1105302.0   15.353270\n4    JUAN DE ACOSTA            252         178618.0   14.108321\n15      SABANALARGA           1093         785276.0   13.918673\n18          SOLEDAD           6997        5229151.0   13.380757\n5           LURUACO            284         240991.0   11.784672\n19             SUAN            119         103469.0   11.501029","content_type":"text/plain"},"text/html":{"content":"\n  <div id=\"df-93547fcf-2b71-4685-ae95-f88c01c4cb2b\" class=\"colab-df-container\">\n    <div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>municipio</th>\n      <th>casos_totales</th>\n      <th>poblacion_total</th>\n      <th>incidencia</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>10</th>\n      <td>POLONUEVO</td>\n      <td>399</td>\n      <td>155707.0</td>\n      <td>25.625052</td>\n    </tr>\n    <tr>\n      <th>0</th>\n      <td>BARANOA</td>\n      <td>1028</td>\n      <td>539600.0</td>\n      <td>19.051149</td>\n 