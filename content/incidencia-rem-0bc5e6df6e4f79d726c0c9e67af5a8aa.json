:"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"6c594c5120ab1859a966cf93ff1d28d9","path":"/6c594c5120ab1859a966cf93ff1d28d9.png"}}}],"identifier":"e2a08715-output","html_id":"e2a08715-output","key":"kYKO2O5nr2"}],"identifier":"e2a08715","label":"e2a08715","html_id":"e2a08715","key":"kHXV2jGFJQ"},{"type":"block","kind":"notebook-content","data":{"id":"7e00e73a"},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"La densidad poblacional de casos de dengue por municipio presenta una gran variabilidad. El valor promedio es de aproximadamente 14.3 casos por cada 10,000 habitantes, con una desviación estándar de 8.4 casos. Un 25% de los municipios reporta entre 7 a 14.3 casos, mostrando entonces la mitad de los territorios no reportan más de 15 casos por cada 10,000 habitantes. El municipio de Usiacurí es el de mayor densidad de casos (37), este es un dato atípico al conjunto, representando una tasa muy alta. La distribución de la densidad es sesgada hacia la derecha, con municipios de Polovuevo, Baranoa, Galapa y Puerto Colombia reportando más de 20 casos por cada 10,000 habitantes.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HmYeMBn6fH"}],"key":"WgOE4wMyjj"}],"identifier":"7e00e73a","label":"7e00e73a","html_id":"id-7e00e73a","key":"s11r9k8RXw"},{"type":"block","kind":"notebook-code","data":{"id":"18682deb","outputId":"ec1ff723-5aea-4cc6-c362-5ce9331060c3","colab":{"base_uri":"https://localhost:8080/","height":522}},"children":[{"type":"code","lang":"python","executable":true,"value":"# [Gráfico] Mapa casos por municipio según evento\n\neventos = [\"Clasico\", \"Grave\"]\n\nfor evento in eventos:\n    anios = sorted(df[\"año\"].unique())\n    n = len(anios) + 1  # años + total\n\n    # Calcular número de filas y columnas dinámicamente\n    columnas = 4\n    filas = (n + columnas - 1) // columnas\n\n    fig, axes = plt.subplots(filas, columnas, figsize=(5*columnas, 6*filas))\n    axes = axes.flatten()\n\n    # Mapas por año\n    for i, anio in enumerate(anios):\n        casos_anio = (\n            tabla_mun[(tabla_mun[\"año\"] == anio) & (tabla_mun[\"evento\"] == evento)]\n            .groupby(\"municipio\")[\"incidencia\"].sum()   # sumar incidencia por municipio\n            .reset_index()\n        )\n\n        gdf_plot = gdf.merge(casos_anio, on=\"municipio\", how=\"left\").fillna(0)\n\n        gdf_plot.plot(column=\"incidencia\", cmap=\"Purples\", linewidth=0.8, edgecolor=\"0.8\",\n                      legend=True, ax=axes[i])\n        axes[i].set_title(f\"Dengue {evento} {anio}\")\n        axes[i].axis(\"off\")\n\n    gdf_total = gdf.merge(incidencia[['municipio','incidencia']], on=\"municipio\", how=\"left\").fillna(0)\n    gdf_total.plot(column=\"incidencia\", cmap=\"Purples\", linewidth=0.8, edgecolor=\"0.8\",\n                legend=True, ax=axes[-1])\n    axes[-1].set_title(f\"Dengue {evento} incidencia\")\n    axes[-1].axis(\"off\")\n\n\n    # Ocultar subplots vacíos (si sobran)\n    for j in range(len(anios) + 1, len(axes)):\n        axes[j].axis(\"off\")\n\n    plt.tight_layout()\n    plt.show()\n","identifier":"18682deb-code","enumerator":"7","html_id":"id-18682deb-code","key":"rDAImwo2W9"},{"type":"output","id":"7GN9Bt5fyhUQyN9Qnvx1Z","data":[{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 2000x1200 with 16 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"12a415cd6fc9c718c9add5ec286eab05","path":"/12a415cd6fc9c718c9add5ec286eab05.png"}}},{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 2000x1200 with 16 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"ae236a1c7bf24dd2d2504709f571896b","path":"/ae236a1c7bf24dd2d2504709f571896b.png"}}}],"identifier":"18682deb-output","html_id":"id-18682deb-output","key":"zhFwMyAOHb"}],"identifier":"18682deb","label":"18682deb","html_id":"id-18682deb","key":"b66u4qaDHV"}],"key":"FL1MLlgNMY"},"references":{"cite":{"order":[],"data":{}}}}